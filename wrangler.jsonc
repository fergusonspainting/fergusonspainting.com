{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fergusonspainting-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // Secrets (TURNSTILE_SECRET, RESEND_API_KEY) are set in the dashboard, never here: this repo is public.
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
